#!/usr/bin/env python3
"""
agsearch — global full-text search across all your coding agent sessions.

Claude Code and Codex CLI each store every session as local JSONL (~/.claude/projects/
and ~/.codex/sessions/). Neither has cross-session search. This indexes all of them into
one ranked search, shows the matched lines, and drops you straight back into the session
with `claude --resume` or `codex resume`.

Run `agsearch --help` for the full flag and key list.

The TUI is the product: a ranked one-row-per-session list, a preview card that shows the
lines that matched, and live filters (scope / agent / automation / order) you flip with a
keystroke instead of relaunching. Enter resumes in place; ctrl-t resumes in a NEW TAB of the
terminal you're already in; ctrl-o reads the whole transcript in a pager without resuming at
all; ctrl-y copies the resume command. Resume is id-based, so a session whose project dir was
deleted still resumes, from the nearest surviving ancestor dir. Sessions that still look live
are marked ● and confirm before resuming.

Internal subcommands, all called back into by fzf: _filter, _preview, _transcript, _header,
_help, _toggle, _copy, _tab.

Warm runs are near-instant: parsed sessions are cached per-file and only re-parsed
when their .jsonl mtime changes.
"""

import os
import re
import sys
import math
import json
import shlex
import time
import shutil
import hashlib
import subprocess

HOME = os.path.expanduser("~")
PROJECTS_DIR = os.path.join(HOME, ".claude", "projects")
CODEX_DIR = os.path.join(HOME, ".codex", "sessions")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "agsearch")
FRAG_DIR = os.path.join(CACHE_DIR, "frag")
META_PATH = os.path.join(CACHE_DIR, "meta.json")
SESSIONS_PATH = os.path.join(CACHE_DIR, "sessions.tsv")   # one line per session, for _filter
SUBMAP_PATH = os.path.join(CACHE_DIR, "submap.json")      # parent-sid -> [subagent file paths]
INDEX_PATH = os.path.join(CACHE_DIR, "index.json")        # sid -> {source, path} for preview/resume
TUI_STATE_PATH = os.path.join(CACHE_DIR, "tui-state.json")  # live filter toggles for the fzf session

CACHE_FMT = 4   # bump when the TSV column layout / keying changes, to invalidate old fragments

# TSV columns (tab-separated, one row per message):
#   0 session_id  1 cwd  2 gitBranch  3 iso_date  4 role  5 seq  6 title  7 text
SEP = "\t"

# A session whose transcript was appended to this recently is almost certainly still running
# (an agent mid-turn, or a CLI you have open in another tab). Marked ● live in the list.
ACTIVE_WINDOW_SEC = 180

# sessions.tsv columns (written by build_sessions, read by cmd_filter).
C_SID, C_CWD, C_DATE, C_SOURCE, C_KIND, C_TITLE, C_FIRST, C_BLOB = range(8)
SESSION_COLS = 8

# Ranking knobs — see rank_sessions(). k1/b are textbook BM25; b<1 keeps length normalization
# firm but not brutal, since a long session that genuinely discusses a term should still win
# over a short one that name-drops it. Fields are weighted: what you opened the session ASKING
# for (first prompt) beats what got said somewhere in hour three.
BM25_K1 = 1.2
BM25_B = 0.65
W_TITLE = 2.0
W_FIRST = 2.5
W_BODY = 1.0
RECENCY_HALFLIFE_DAYS = 45.0
RECENCY_W = 0.35          # max multiplier bump for a session from today
USAGE_W = 0.30            # max multiplier bump for a session you resume often


# ------------------------------------------------------------------ parsing

def _flatten_content(content):
    """Pull human-readable text out of a message.content (str or block list)."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for b in content:
            if isinstance(b, str):
                parts.append(b)
            elif isinstance(b, dict):
                t = b.get("type")
                if t == "text" and b.get("text"):
                    parts.append(b["text"])
                elif t == "tool_result":
                    parts.append(_flatten_content(b.get("content", "")))
        return "\n".join(p for p in parts if p)
    return ""


def _single_line(s, limit=400):
    return " ".join(s.split())[:limit]


def _flag(v):
    """Parse a flag that arrived either as a Python bool or as an argv string from fzf."""
    return str(v).lower() in ("1", "true")


def parse_session(path, include_thinking=False, limit=400):
    """Parse one .jsonl file into ordered index rows (8-field lists, seq assigned).

    Rows are keyed by each entry's `sessionId` field, not the filename. For normal sessions
    those are identical; for `agent-*.jsonl` subagent transcripts the sessionId points to the
    PARENT conversation, so subagent content folds into (and resumes) its parent session.
    """
    file_id = os.path.splitext(os.path.basename(path))[0]
    session_id = file_id
    title = ""
    cwd = ""
    branch = ""
    entry = ""
    rows = []   # each: [sid, cwd, branch, ts, role, title, text]
    try:
        fh = open(path, "r", errors="replace")
    except OSError:
        return session_id, []
    with fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                o = json.loads(line)
            except json.JSONDecodeError:
                continue
            t = o.get("type")
            if t == "ai-title" and o.get("aiTitle"):
                title = o["aiTitle"]
                continue
            if t not in ("user", "assistant"):
                continue
            session_id = o.get("sessionId") or session_id   # parent id for agent-* files
            cwd = o.get("cwd", cwd)
            branch = o.get("gitBranch", branch)
            entry = o.get("entrypoint") or entry            # cli vs sdk-py/sdk-ts
            msg = o.get("message", {}) or {}
            role = msg.get("role", t)
            ts = o.get("timestamp", "")

            if t == "assistant" and include_thinking:
                content = msg.get("content")
                if isinstance(content, list):
                    for b in content:
                        if isinstance(b, dict) and b.get("type") == "thinking" and b.get("thinking"):
                            rows.append([session_id, cwd, branch, ts, "thinking", title,
                                         _single_line(b["thinking"], limit)])

            text = _single_line(_flatten_content(msg.get("content", "")), limit)
            if not text:
                continue
            rows.append([session_id, cwd, branch, ts, role, title, text])

    # Titles can appear after the messages they label; backfill, then stamp sequence.
    # `kind` marks who drove the session: your own CLI use vs a plugin/SDK-spawned run.
    kind = "auto" if entry.startswith("sdk") else "cli"
    final = []
    for i, r in enumerate(rows):
        final.append([r[0], r[1], r[2], r[3], r[4], str(i), title or r[5], r[6], kind])
    return session_id, final


_CODEX_NOISE = ("<environment_context>", "<permissions", "<multi_agent_mode>", "<user_instructions>")

# Codex user messages often lead with injected preambles instead of the real task. Pick the
# first message that's an actual request: strip a known security-preamble prefix, and skip
# messages that are pure wrappers (AGENTS.md dumps, XML blocks, leftover preamble).
_CODEX_PREAMBLE_ANCHOR = "repository code only."   # end of the injected security preamble
_CODEX_SKIP_PREFIXES = ("<", "# agents.md", "agents.md instructions", "important: do not")


def _codex_title(user_texts):
    for t in user_texts:
        t = t.strip()
        if _CODEX_PREAMBLE_ANCHOR in t:            # real task is appended after the preamble
            t = t.split(_CODEX_PREAMBLE_ANCHOR, 1)[1].strip()
        if not t or t.lower().startswith(_CODEX_SKIP_PREFIXES):
            continue                               # pure boilerplate → try the next message
        return t[:90]
    return ""


def parse_codex_session(path, include_thinking=False, limit=400):
    """Parse an OpenAI Codex CLI rollout file into the same 8-field row schema as Claude.

    Session id/cwd come from the `session_meta` entry; messages are `response_item` entries of
    payload type "message" (roles user/assistant; `developer`/`system` and injected context are
    dropped). Keyed by the meta `id` UUID, which is what `codex resume <id>` takes.
    """
    sid = os.path.splitext(os.path.basename(path))[0]
    cwd = branch = ts0 = ""
    rows = []
    try:
        fh = open(path, "r", errors="replace")
    except OSError:
        return sid, []
    with fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                o = json.loads(line)
            except json.JSONDecodeError:
                continue
            t = o.get("type")
            if t == "session_meta":
                p = o.get("payload", {}) or {}
                sid = p.get("id") or p.get("session_id") or sid
                cwd = p.get("cwd", cwd)
                ts0 = p.get("timestamp", ts0)
                g = p.get("git")
                if isinstance(g, dict):
                    branch = g.get("branch") or branch
                continue
            if t != "response_item":
                continue
            p = o.get("payload", {}) or {}
            if p.get("type") != "message" or p.get("role") not in ("user", "assistant"):
                continue
            c = p.get("content")
            if isinstance(c, str):
                text = c
            elif isinstance(c, list):
                text = " ".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("text"))
            else:
                text = ""
            text = _single_line(text, limit)
            if not text or text.lstrip().startswith(_CODEX_NOISE):
                continue
            rows.append([sid, cwd, branch, o.get("timestamp") or ts0, p["role"], "", "", text])

    title = _codex_title([r[7] for r in rows if r[4] == "user"])
    final = [[sid, r[1], r[2], r[3], r[4], str(i), title, r[7], "cli"] for i, r in enumerate(rows)]
    return sid, final


# ------------------------------------------------------------------ cache

def _frag_path(jsonl_path):
    key = hashlib.sha1(jsonl_path.encode()).hexdigest()[:16]
    return os.path.join(FRAG_DIR, key + ".tsv")


class _Progress:
    """Counts freshly parsed sessions on stderr, and only when someone is watching.

    Written to stderr so `agsearch -n … | grep` stays clean, and gated on isatty so the line
    never lands in a pipe or in fzf's reload output.
    """

    def __init__(self, total, stream=None, every=25):
        self.total = total
        self.done = 0
        self.every = every
        self.stream = stream if stream is not None else sys.stderr
        self.on = bool(getattr(self.stream, "isatty", lambda: False)())

    def tick(self):
        self.done += 1
        if self.on and self.done % self.every == 0:
            self.stream.write(f"\r\033[2mindexing… {self.done}/{self.total} sessions\033[0m")
            self.stream.flush()

    def close(self):
        if self.on and self.done >= self.every:
            self.stream.write("\r\033[K")
            self.stream.flush()


def build_index(include_thinking=False, force=False):
    """Return the full index as a list of TSV strings, refreshing per-file caches."""
    os.makedirs(FRAG_DIR, exist_ok=True)
    meta = {}
    if os.path.exists(META_PATH) and not force:
        try:
            meta = json.load(open(META_PATH))
        except (OSError, json.JSONDecodeError):
            meta = {}
    if meta.get("_thinking") != include_thinking or meta.get("_fmt") != CACHE_FMT:
        force = True          # thinking toggle or format change invalidates fragments
        meta = {}

    # Each source: (tag, root dir, parser). Add more agents here later (Cursor, Gemini…).
    sources = [("cc", PROJECTS_DIR, parse_session), ("codex", CODEX_DIR, parse_codex_session)]
    files = []                          # (path, source, parser)
    for source, root, parser in sources:
        if os.path.isdir(root):
            for r, _dirs, fs in os.walk(root):
                for fn in fs:
                    if fn.endswith(".jsonl"):
                        files.append((os.path.join(r, fn), source, parser))

    new_meta = {"_thinking": include_thinking, "_fmt": CACHE_FMT}
    live_frags = set()
    lines = []
    sub_map = {}                        # parent sid -> [subagent file paths] (Claude only)
    index = {}                          # sid -> {source, path} for preview + resume routing
    # A cold build over a thousand sessions takes seconds. Silence for seconds reads as a hang,
    # so count the ones actually being parsed (cache hits are instant and not worth reporting).
    progress = _Progress(len(files))
    for path, source, parser in files:
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        frag = _frag_path(path)
        live_frags.add(os.path.basename(frag))
        if not force and meta.get(path) == mtime and os.path.exists(frag):
            with open(frag, errors="replace") as fh:
                frag_lines = fh.read().splitlines()
        else:
            progress.tick()
            _sid, rows = parser(path, include_thinking)
            frag_lines = [SEP.join(r) for r in rows]
            with open(frag, "w") as fh:
                fh.write("\n".join(frag_lines))
        new_meta[path] = mtime
        lines.extend(frag_lines)
        if not frag_lines:
            continue
        sid0 = frag_lines[0].split(SEP, 1)[0]
        base = os.path.basename(path)
        if source == "cc" and base.startswith("agent-"):
            sub_map.setdefault(sid0, []).append(path)     # subagent folds into parent
        else:
            index[sid0] = {"source": source, "path": path}

    for fn in os.listdir(FRAG_DIR):     # drop fragments for deleted sessions
        if fn not in live_frags:
            try:
                os.remove(os.path.join(FRAG_DIR, fn))
            except OSError:
                pass

    json.dump(new_meta, open(META_PATH, "w"))
    json.dump(sub_map, open(SUBMAP_PATH, "w"))
    json.dump(index, open(INDEX_PATH, "w"))
    progress.close()
    return lines


# ------------------------------------------------------------------ filtering

def apply_scope(lines, here=False, project=None):
    if here:
        cwd = os.getcwd()
        lines = [l for l in lines
                 if l.split(SEP, 2)[1] == cwd or l.split(SEP, 2)[1].startswith(cwd + os.sep)]
    if project:
        p = project.lower()
        lines = [l for l in lines if p in l.split(SEP, 2)[1].lower()]
    return lines


def rank_matches(lines, query):
    """AND-of-terms substring filter, ranked by recency (iso date desc)."""
    terms = [t.lower() for t in query.split()]
    hits = [l for l in lines if all(t in l.lower() for t in terms)]
    hits.sort(key=lambda l: l.split(SEP)[3], reverse=True)
    return hits


# ------------------------------------------------------------------ rendering

def short_proj(cwd):
    return os.path.basename(cwd.rstrip("/")) or cwd


def _highlight(text, terms, code="\033[1;30;43m"):
    """Highlight EVERY occurrence of every query term (case-insensitive).

    One highlight per term was enough to prove the line matched, but the eye uses the density
    of highlights to judge whether a line is *about* the term or merely mentions it.
    """
    live = sorted({t for t in terms if t}, key=len, reverse=True)
    if not live:
        return text
    pat = re.compile("|".join(re.escape(t) for t in live), re.I)
    return pat.sub(lambda m: code + m.group(0) + "\033[0m", text)


ROW_TEXT_WIDTH = 160        # keeps -n rows one terminal line each, however big the message was


def fmt_row(l, terms=()):
    f = (l.split(SEP) + [""] * 8)[:8]
    sid, cwd, branch, ts, role, seq, title, text = f
    tag = {"user": "you", "assistant": "cc", "thinking": "th"}.get(role, role)
    body = _snippet(text, [t for t in terms if t], ROW_TEXT_WIDTH)
    return f"{ts[:10]}  {short_proj(cwd)[:18]:<18}  {tag:<3} {title[:32]:<32} │ {body}"


def print_matches(lines, query, limit=40):
    hits = rank_matches(lines, query) if query else lines
    if not hits:
        print("No matches.", file=sys.stderr)
        return 1
    terms = [t.lower() for t in query.split()]
    for l in hits[:limit]:
        print(fmt_row(l, terms))
    extra = len(hits) - limit
    if extra > 0:
        print(f"... and {extra} more (narrow the query or use the fzf TUI).", file=sys.stderr)
    return 0


def _session_path(sid):
    if os.path.isdir(PROJECTS_DIR):
        for root, _dirs, files in os.walk(PROJECTS_DIR):
            if sid + ".jsonl" in files:
                return os.path.join(root, sid + ".jsonl")
    return None


def _label(role):
    return {"user": "\033[36myou\033[0m", "assistant": "\033[32mcc \033[0m",
            "thinking": "\033[90mth \033[0m"}.get(role, (role + "   ")[:3])


# --- snippet cleanup: transcripts are full of payloads nobody wants to read in a result row.
_IMAGE_RE = re.compile(r"\[Image:[^\]]*\]")
_FENCE_RE = re.compile(r"```[a-zA-Z0-9_+.-]*.*?```", re.S)      # closed fence
_OPEN_FENCE_RE = re.compile(r"```[a-zA-Z0-9_+.-]*.*", re.S)     # fence cut off by the 400-char cap
_MD_LINK_RE = re.compile(r"!?\[([^\]\n]{1,80})\]\([^)\s]*\)")   # [text](url) -> text
_MD_CODESPAN_RE = re.compile(r"`+([^`]+)`+")
# Emphasis markers only count when they stand alone — otherwise a C-style /** comment */ or a
# glob pattern gets shredded into gibberish.
_MD_BOLD_RE = re.compile(r"(?<![\w/*])(\*\*|__)(?!\s)(.+?)(?<!\s)\1(?![\w/*])", re.S)
_MD_ITALIC_RE = re.compile(r"(?<![\w/*])\*(?!\s)([^*/\n]{1,160}?)(?<!\s)\*(?![\w/*])")
_MD_HEADING_RE = re.compile(r"(?:^|(?<= ))#{1,6}\s+")
# Newlines are already collapsed by index time, so a mid-string "- " is ambiguous with a dash in
# prose. Only strip one when it introduces a bold/heading run — the shape list items actually have.
_MD_BULLET_RE = re.compile(r"(?:^|(?<= ))[-*+•]\s+(?=\*\*|#{1,6}\s)")
_MD_LEAD_LIST_RE = re.compile(r"^\s*(?:[-*+•]|\d+\.|>)\s+")
_LONG_TOKEN_RE = re.compile(r"\S{45,}")


def _condense_json(s, minlen=40):
    """Replace embedded JSON objects/arrays with a [json] placeholder. Hand-scanned rather than
    regexed because these dumps nest, and they're routinely truncated mid-structure."""
    out = []
    i, n = 0, len(s)
    while i < n:
        c = s[i]
        nxt = s[i + 1:i + 3].lstrip()[:1]
        if c in "[{" and nxt in ('"', "{", "["):
            j, depth, in_str, esc = i, 0, False, False
            while j < n:
                ch = s[j]
                if in_str:
                    if esc:
                        esc = False
                    elif ch == "\\":
                        esc = True
                    elif ch == '"':
                        in_str = False
                elif ch == '"':
                    in_str = True
                elif ch in "[{":
                    depth += 1
                elif ch in "]}":
                    depth -= 1
                    if depth == 0:
                        j += 1
                        break
                j += 1
            if j - i >= minlen:                  # short inline objects read fine, leave them
                out.append("[json]")
                i = j
                continue
        out.append(c)
        i += 1
    return "".join(out)


def _condense_line_numbers(s, minrun=4):
    """`cat -n`-style file reads — "1 import x 2 import y 3 …" — are pure noise once newlines
    are gone. Collapse a run of ascending bare line numbers into a [file] placeholder. Bare
    digits only, so a "1. do this 2. do that" prose list is left alone."""
    toks = s.split(" ")
    out, i, n = [], 0, len(toks)
    while i < n:
        if toks[i].isdigit():
            last, chain = int(toks[i]), [i]
            for k in range(i + 1, n):
                if toks[k].isdigit():
                    v = int(toks[k])
                    if 0 < v - last <= 3:      # small gaps = blank lines in the file
                        last, _ = v, chain.append(k)
                    else:
                        break
            if len(chain) >= minrun:
                out.append("[file]")
                i = chain[-1] + 1
                continue
        out.append(toks[i])
        i += 1
    return " ".join(out)


def clean_snippet(text):
    """Turn one raw transcript message into readable prose for a result row.

    Strips markdown noise (fences, headings, bullets, emphasis, link syntax) and condenses
    payloads — JSON dumps, pasted images, long opaque tokens — into short placeholders, so a
    snippet shows what was said rather than what was dumped. Search still runs over the raw
    text; this is display only.
    """
    if not text:
        return ""
    t = _FENCE_RE.sub(" [code] ", text)
    t = _OPEN_FENCE_RE.sub(" [code] ", t)
    t = _IMAGE_RE.sub(" [image] ", t)
    t = _condense_json(t)
    t = _condense_line_numbers(t)
    t = _MD_LINK_RE.sub(r"\1", t)
    t = _MD_CODESPAN_RE.sub(r"\1", t)
    t = _MD_LEAD_LIST_RE.sub("", t)
    t = _MD_BULLET_RE.sub("", t)          # before emphasis: the bullet is spotted by the ** it leads
    t = _MD_BOLD_RE.sub(r"\2", t)
    t = _MD_ITALIC_RE.sub(r"\1", t)
    t = _MD_HEADING_RE.sub("", t)
    t = _LONG_TOKEN_RE.sub(lambda mo: mo.group(0)[:20] + "…", t)
    return " ".join(t.split())


def _snippet(text, terms, width=200):
    """A readable window of text centered on the first matching term, highlighted.

    Cleaned first, so the window shows prose instead of raw payload. If the match only exists
    in the part that got condensed, fall back to the raw text — a snippet without the term you
    searched for is worse than a noisy one.
    """
    live = [t for t in terms if t]
    clean = clean_snippet(text)
    if live and not any(t in clean.lower() for t in live):
        clean = _single_line(text, len(text))
    lo = clean.lower()
    pos = min([lo.find(t) for t in live if t in lo] or [0])
    start = max(0, pos - 40)
    frag = clean[start:start + width]
    if start:
        frag = "…" + frag
    if start + width < len(clean):
        frag += "…"
    return _highlight(frag, live)


def load_session_rows(sid, thinking=False, limit=400):
    """(source, [(row, is_subagent)]) for one session, chronological.

    Shared by the preview card and the full-transcript reader so both see exactly the same
    conversation, subagent turns folded in and all.
    """
    try:
        index = json.load(open(INDEX_PATH))
    except (OSError, json.JSONDecodeError):
        index = {}
    info = index.get(sid, {})
    source = info.get("source", "cc")
    path = info.get("path") or _session_path(sid)

    tagged = []
    if source == "codex":
        if path:
            _s, rows0 = parse_codex_session(path, include_thinking=thinking, limit=limit)
            tagged = [(r, False) for r in rows0]
    else:
        if path:
            _s, prows = parse_session(path, include_thinking=thinking, limit=limit)
            tagged += [(r, False) for r in prows]
        try:
            submap = json.load(open(SUBMAP_PATH))
        except (OSError, json.JSONDecodeError):
            submap = {}
        for sp in submap.get(sid, [])[:40]:
            _s, srows = parse_session(sp, include_thinking=thinking, limit=limit)
            tagged += [(r, True) for r in srows]
    tagged.sort(key=lambda x: x[0][3])   # chronological by timestamp
    return source, tagged


def _card_header(rows, tagged, source):
    """Title line + the identity line under it: where, which branch, when, how big."""
    r0 = rows[0]
    n_sub = sum(1 for _, sub in tagged if sub)
    disp_title = r0[6] or next((r[7] for r, _ in tagged if r[4] == "user"), "") or "(untitled)"
    print(f"\033[1m{disp_title[:80]}\033[0m")
    bits = [short_proj(r0[1])]
    if r0[2]:                                   # gitBranch: which line of work this session was
        bits.append(f"\033[35m{r0[2][:28]}\033[0m\033[2m")
    bits += [r0[3][:10], f"{len(rows)} msgs", "claude" if source != "codex" else "codex"]
    if n_sub:
        bits.append(f"{n_sub} subagent")
    if r0[1] and not os.path.isdir(r0[1]):
        bits.append("orig dir gone")
    print("\033[2m" + " · ".join(bits) + "\033[0m")


def render_preview(sid, thinking, query):
    """Compact preview card for one session (no full transcript — that's ctrl-o / resume).

    With a query: the matched lines only, highlighted. Without one: the bookends (first prompt
    + last message) so you know what it was about. Merges subagent transcripts (tagged ⤷) so
    their content is previewable too. Re-runs per keystroke via fzf's {q}.
    """
    thinking = _flag(thinking)
    if sid == NO_SID:
        print("\033[2mNothing to preview.\n\nEvery session is still indexed — the current "
              "filters just exclude them all.\nThe header shows which key relaxes which "
              "filter.\033[0m")
        return
    source, tagged = load_session_rows(sid, thinking)
    if not tagged:
        print("(session not found)")
        return
    rows = [r for r, _ in tagged]

    keys = query_keys(parse_query(query)) if query.strip() else []
    _card_header(rows, tagged, source)

    if keys:
        # Same keys as rank_sessions, AND-matched on message text only (not title/typo).
        matches = [(r, sub) for r, sub in tagged if all(k in r[7].lower() for k in keys)]
        print(f"\n\033[1;33m● {len(matches)} match(es)\033[0m")
        for r, sub in matches[:6]:
            tag = "\033[35m⤷\033[0m" if sub else " "
            print(f"{tag}{_label(r[4])} {_snippet(r[7], keys, 200)}")
        if len(matches) > 6:
            print(f"  \033[2m… {len(matches) - 6} more — ctrl-o reads the whole thing\033[0m")
    else:
        # No query yet: just the bookends so you know what the session was about.
        first_user = next((r for r, _ in tagged if r[4] == "user"), None)
        if first_user:
            print(f"\n\033[2mopened with\033[0m  {_snippet(first_user[7], [], 220)}")
        print(f"\033[2mlast\033[0m  {_label(rows[-1][4])} {_snippet(rows[-1][7], [], 220)}")

    # What Enter is actually about to run. Resume relocates when the recorded dir is gone, and
    # that surprise belongs in the preview, not in the scrollback after the CLI has taken over.
    print(f"\n\033[2m⏎  {resume_command(sid, rows[0][1], source)}\033[0m")


def render_transcript(sid, thinking=False, query=""):
    """The whole conversation, readable, without resuming it.

    Resuming to read costs a CLI start, a context load, and a session you then have to leave.
    Most of the time you only wanted to check whether this is the right session, or to copy one
    answer out of it. Matched lines are marked ▶ so you can jump between them in the pager.
    """
    thinking = _flag(thinking)
    # Full message text here, not the 400-char index cap: this view exists to be read.
    source, tagged = load_session_rows(sid, thinking, limit=100_000)
    if not tagged:
        print("(session not found)")
        return
    rows = [r for r, _ in tagged]
    keys = query_keys(parse_query(query)) if query.strip() else []
    _card_header(rows, tagged, source)
    print(f"\033[2m{resume_command(sid, rows[0][1], source)}\033[0m\n")
    for r, sub in tagged:
        text = clean_snippet(r[7])
        hit = bool(keys) and all(k in r[7].lower() for k in keys)
        mark = "\033[1;33m▶\033[0m" if hit else " "
        tag = "\033[35m⤷\033[0m" if sub else " "
        print(f"{mark}{tag}{_label(r[4])} \033[2m{r[3][11:16]}\033[0m  "
              f"{_highlight(text, keys) if keys else text}\n")


# ------------------------------------------------------------------ clipboard

# Tried in order; the first one present on PATH wins. macOS first because that's where the
# ⌘F handoff matters most, then Wayland, then the two X11 standards.
CLIPBOARDS = [("pbcopy", ["pbcopy"]),
              ("wl-copy", ["wl-copy"]),
              ("xclip", ["xclip", "-selection", "clipboard"]),
              ("xsel", ["xsel", "--clipboard", "--input"])]


def clipboard_argv(which=None):
    """argv of the first available clipboard tool, or None if the box has none."""
    which = which or shutil.which
    for exe, argv in CLIPBOARDS:
        if which(exe):
            return argv
    return None


def copy_to_clipboard(text, which=None):
    """Best-effort copy. Returns True if some clipboard tool accepted the text."""
    argv = clipboard_argv(which)
    if not argv:
        return False
    try:
        subprocess.run(argv, input=text, text=True, check=False)
        return True
    except OSError:
        return False


# ------------------------------------------------------------------ terminal integration

def _osa_str(s):
    """Escape a Python string for embedding inside an AppleScript double-quoted literal."""
    return s.replace("\\", "\\\\").replace('"', '\\"')


_ITERM_OSA = '''
tell application "iTerm"
  activate
  if (count of windows) = 0 then
    create window with default profile command "{cmd}"
  else
    tell current window to create tab with default profile command "{cmd}"
  end if
end tell
'''

# Terminal.app has no "create tab" verb, so the tab has to come from a ⌘T keystroke (which needs
# Accessibility permission). If System Events is blocked the script still errors out cleanly and
# the caller falls back to a plain window.
_TERMINAL_OSA = '''
tell application "Terminal"
  activate
  if (count of windows) = 0 then
    do script "{cmd}"
  else
    tell application "System Events" to keystroke "t" using command down
    delay 0.3
    do script "{cmd}" in front window
  end if
end tell
'''


def pick_terminal(env=None, which=None, platform=None, has_iterm=None):
    """Name of the terminal to ask for a tab: AGSEARCH_TERMINAL, else the one you're inside.

    The environment is the only signal that survives being launched from a hotkey daemon with
    no controlling terminal, so it's checked before anything platform-specific. Returns "" when
    nothing here knows how to make a tab.
    """
    env = os.environ if env is None else env
    which = which or shutil.which
    platform = platform or sys.platform
    if has_iterm is None:
        has_iterm = os.path.isdir("/Applications/iTerm.app")

    forced = (env.get("AGSEARCH_TERMINAL") or "").lower()
    if forced:
        return forced
    prog = (env.get("TERM_PROGRAM") or "").lower()
    if env.get("TMUX") and which("tmux"):
        return "tmux"
    if env.get("KITTY_WINDOW_ID") and which("kitty"):
        return "kitty"
    if prog == "wezterm" and which("wezterm"):
        return "wezterm"
    if platform == "darwin":
        # No TERM_PROGRAM means a hotkey launched us with no terminal at all; iTerm is then the
        # better guess than Terminal.app, whose tabs need Accessibility permission.
        return "iterm" if (prog.startswith("iterm") or (not prog and has_iterm)) else "terminal"
    for exe in ("gnome-terminal", "konsole", "xfce4-terminal"):
        if which(exe):
            return exe
    return ""


def tab_launcher(inner, env=None, which=None, platform=None, has_iterm=None):
    """argv that runs shell command `inner` in a NEW TAB of the terminal you're in.

    "New tab, not new window" is the whole point: agsearch replaces itself with the resumed
    CLI, so the tab it opens in *becomes* that session — a new window each time is what makes
    a hotkey search feel like a stray popup instead of part of your terminal.

    Returns None when no terminal here can be scripted, so the caller can say so plainly.
    """
    env = os.environ if env is None else env
    shell = env.get("SHELL") or "/bin/sh"

    override = env.get("AGSEARCH_TERMINAL_CMD")
    if override:                       # escape hatch for terminals nothing here handles
        return ["sh", "-c", override.replace("{cmd}", shlex.quote(inner))]

    term = pick_terminal(env, which, platform, has_iterm)
    osa = _osa_str("{} -lc {}".format(shell, shlex.quote(inner)))
    return {
        "tmux": ["tmux", "new-window", inner],
        "kitty": ["kitty", "@", "launch", "--type=tab", shell, "-lc", inner],
        "wezterm": ["wezterm", "cli", "spawn", "--", shell, "-lc", inner],
        "iterm": ["osascript", "-e", _ITERM_OSA.format(cmd=osa)],
        "terminal": ["osascript", "-e", _TERMINAL_OSA.format(cmd=osa)],
        "gnome-terminal": ["gnome-terminal", "--tab", "--", shell, "-lc", inner],
        "konsole": ["konsole", "--new-tab", "-e", shell, "-lc", inner],
        "xfce4-terminal": ["xfce4-terminal", "--tab", "-x", shell, "-lc", inner],
    }.get(term)


def open_in_tab(inner):
    """Run `inner` in a new terminal tab. Returns False when no terminal could be scripted."""
    argv = tab_launcher(inner)
    if not argv:
        return False
    try:
        subprocess.run(argv, check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except OSError:
        return False


def resume_command(sid, cwd, source="cc"):
    """The shell one-liner that reattaches this session, safe to paste anywhere."""
    target = cwd if (cwd and os.path.isdir(cwd)) else _nearest_existing_dir(cwd)
    bin_argv = ["codex", "resume", sid] if source == "codex" else ["claude", "--resume", sid]
    return "cd {} && {}".format(shlex.quote(target or HOME), " ".join(bin_argv))


def _source_of(sid):
    try:
        return json.load(open(INDEX_PATH)).get(sid, {}).get("source", "cc")
    except (OSError, json.JSONDecodeError):
        return "cc"


# ------------------------------------------------------------------ resume

def _die(msg):
    """Show an error and hold the window open — otherwise the popup just vanishes."""
    print(f"\n\033[31m{msg}\033[0m\n", file=sys.stderr)
    try:
        input("press enter to close ")
    except (EOFError, KeyboardInterrupt):
        pass
    sys.exit(1)


def _nearest_existing_dir(path):
    """Closest existing ancestor of `path` (the path itself if it exists), else $HOME.

    Worktrees get deleted, but `claude --resume <id>` / `codex resume <id>` are id-based and
    don't need the original directory — so a dead cwd is a reason to relocate, not to abort.
    """
    p = os.path.abspath(os.path.expanduser(path)) if path else ""
    while p and p != os.sep:
        if os.path.isdir(p):
            return p
        parent = os.path.dirname(p)
        if parent == p:
            break
        p = parent
    if os.path.isdir(os.sep) and not os.path.isdir(HOME):
        return os.sep
    return HOME


def _confirm_active(sid, bin_):
    """Warn that a session still looks live, and ask before attaching. Never hard-blocks:
    with no tty to prompt on (fzf popup, piped run) it warns and proceeds."""
    warn = (f"\033[33m⚠ this session looks active (written to in the last "
            f"{ACTIVE_WINDOW_SEC}s) — resuming may collide with the running {bin_}.\033[0m")
    print(warn, file=sys.stderr)
    if not sys.stdin.isatty():
        return True
    try:
        ok = input("resume anyway? [Y/n] ").strip().lower() in ("", "y", "yes")
    except (EOFError, KeyboardInterrupt):
        return True
    if not ok:
        print("aborted.", file=sys.stderr)
    return ok


def resume(sid, cwd, query="", active=False):
    if query:
        copy_to_clipboard(query)                    # stash query so ⌘F finds it in-session
    source = _source_of(sid)
    bin_, argv = ("codex", ["codex", "resume", sid]) if source == "codex" \
        else ("claude", ["claude", "--resume", sid])

    # The recorded worktree may be long gone. Resume is id-based, so relocate to the nearest
    # surviving ancestor (or $HOME) instead of refusing to launch.
    cwd_exists = bool(cwd) and os.path.isdir(cwd)
    target = cwd if cwd_exists else (_nearest_existing_dir(cwd) if cwd else "")

    # Leave a trace: if the launched CLI dies instantly the popup window vanishes with it,
    # so this log is the only way to see what was attempted.
    note = f"cd {target or cwd} && {' '.join(argv)}"
    try:
        with open(os.path.join(CACHE_DIR, "last-resume.log"), "a") as fh:
            fh.write(f"{note}   [source={source} cwd_exists={cwd_exists}"
                     f" orig_cwd={cwd or '-'} fallback={'-' if cwd_exists else (target or '-')}"
                     f" active={bool(active)}]\n")
    except OSError:
        pass

    if not shutil.which(bin_):
        _die(f"{bin_} CLI not found on PATH.\nRun manually:\n  {note}")
    if cwd and not cwd_exists:
        print(f"\033[33moriginal dir gone ({cwd}), resuming from {target}\033[0m", file=sys.stderr)
    if active and not _confirm_active(sid, bin_):
        return
    if target:
        try:
            os.chdir(target)
        except OSError:                              # raced away between check and chdir
            os.chdir(HOME)
    os.execvp(bin_, argv)                            # replace this process


# ------------------------------------------------------------------ fzf TUI

def group_sessions(lines):
    """Collapse per-message index rows into one entry per session, newest first."""
    by = {}
    for l in lines:
        f = (l.split(SEP) + [""] * 9)[:9]
        sid, cwd, _branch, ts, _role, _seq, title, text, kind = f
        g = by.get(sid)
        if g is None:
            g = by[sid] = {"sid": sid, "cwd": cwd, "date": ts, "title": title,
                           "first_user": "", "kind": kind or "cli", "texts": []}
        if ts > g["date"]:
            g["date"] = ts
        if cwd:
            g["cwd"] = cwd
        if kind == "cli":
            g["kind"] = "cli"                # a real CLI turn outranks folded-in agent rows
        if title and not g["title"]:
            g["title"] = title
        if _role == "user" and not g["first_user"]:
            g["first_user"] = text
        g["texts"].append(text)
    sessions = list(by.values())
    for s in sessions:                       # fall back to the first prompt when untitled
        if not s["title"]:
            s["title"] = s["first_user"] or "(untitled)"
    sessions.sort(key=lambda s: s["date"], reverse=True)
    return sessions


def build_sessions(lines):
    """Write one line per session to SESSIONS_PATH: sid, cwd, date, source, kind, title, first
    prompt, blob. The first prompt is stored separately from the blob so ranking can weight it
    as its own field — it's the strongest single signal of what a session is about."""
    try:
        index = json.load(open(INDEX_PATH))
    except (OSError, json.JSONDecodeError):
        index = {}
    out = []
    for s in group_sessions(lines):
        source = index.get(s["sid"], {}).get("source", "cc")
        title = _single_line(s["title"] or "(untitled)", 90)
        first = _single_line(s["first_user"], 400)
        # High cap so full sessions (incl. folded-in subagent content) stay searchable.
        blob = _single_line(" · ".join(s["texts"]), 2_000_000)
        out.append(SEP.join([s["sid"], s["cwd"], s["date"][:10], source, s["kind"],
                             title, first, blob]))
    with open(SESSIONS_PATH, "w") as fh:
        fh.write("\n".join(out))


# Common words that add noise, not signal, to a search ("migration OF alibrary").
_STOP = {"of", "the", "a", "an", "to", "for", "in", "on", "and", "or", "is", "it", "this",
         "that", "with", "from", "by", "at", "as", "be", "are", "was", "were", "how", "do",
         "i", "my", "me", "we", "you", "about", "into", "using", "use", "some", "any"}

def _stem(w):
    """Conservative inflectional stem: strip one reliable suffix only if a solid (>=5 char)
    root remains, so migration/migrate/migrating -> 'migrat' while running stays 'running'
    (better to under-stem than to produce junk roots like 'oper' or 'runn')."""
    for suf in ("ing", "ion", "ed", "es", "e", "s"):
        if w.endswith(suf) and len(w) - len(suf) >= 5:
            return w[:-len(suf)]
    return w


def _fuzzy_span(hay, term):
    """Greedy first subsequence match; returns its character span, or None (last-resort typo tier)."""
    i = start = 0
    for ci, c in enumerate(hay):
        if c == term[i]:
            if i == 0:
                start = ci
            i += 1
            if i == len(term):
                return ci - start + 1
    return None


_SRC_MARK = {"cc": "\033[34mcc  \033[0m", "codex": "\033[35mcx  \033[0m"}
_AUTO_MARK = "\033[90mauto\033[0m"          # plugin/SDK-spawned run, never your own typing
_LIVE_MARK = "\033[1;31m●\033[0m "           # session still being written to → probably running
# Informational only: the session still resumes (from the nearest surviving ancestor dir),
# so this is muted enough to read as a footnote rather than a warning.
_GONE_MARK = "  \033[2morig dir gone\033[0m"


def _active_sids(sids):
    """Subset of `sids` whose transcript — or one of its subagent transcripts — was appended to
    within ACTIVE_WINDOW_SEC, i.e. the session still looks live."""
    try:
        index = json.load(open(INDEX_PATH))
    except (OSError, json.JSONDecodeError):
        index = {}
    try:
        submap = json.load(open(SUBMAP_PATH))
    except (OSError, json.JSONDecodeError):
        submap = {}
    now = time.time()
    live = set()
    for sid in sids:
        for p in [index.get(sid, {}).get("path")] + submap.get(sid, [])[:40]:
            try:
                if p and now - os.path.getmtime(p) <= ACTIVE_WINDOW_SEC:
                    live.add(sid)
                    break
            except OSError:
                continue
    return live


def _missing_dirs(cwds):
    """Which of these recorded working directories no longer exist. Deduped before stat'ing,
    since a project's sessions all share one dir."""
    gone = set()
    for cwd in set(cwds):
        if cwd and not os.path.isdir(cwd):
            gone.add(cwd)
    return gone


def _row(sid, cwd, date, source, kind, title, badge, active=False, dir_gone=False):
    mark = _AUTO_MARK if kind == "auto" else _SRC_MARK.get(source, "    ")
    live = _LIVE_MARK if active else "  "
    tail = _GONE_MARK if dir_gone else ""
    age = f"{rel_age(date):<5}"
    body = (f"{age}  {mark}  \033[36m{short_proj(cwd)[:15]:<15}\033[0m  "
            f"{badge} {live}{title[:64]}{tail}")
    if kind == "auto":
        body = (f"\033[2m{age}  \033[0m{_AUTO_MARK}\033[2m  {short_proj(cwd)[:15]:<15}  "
                f"{badge} \033[0m{live}\033[2m{title[:64]}\033[0m{tail}")
    return SEP.join([sid, cwd, body, "1" if active else "0"])


# A row fzf can display but resume() must refuse: an empty list with no explanation reads as
# "agsearch is broken" when it usually means one of the toggles is on.
NO_SID = "-"


def _empty_row(st, has_query):
    st = st or {}
    hints = []
    if st.get("here"):
        hints.append("ctrl-s widens to all projects")
    if st.get("source") in ("cc", "codex"):
        hints.append("ctrl-g re-includes the other agent")
    if not st.get("auto", 1):
        hints.append("ctrl-x re-includes automation")
    if has_query and not hints:
        hints.append("try fewer or more distinctive words")
    if not hints:
        hints.append("nothing indexed yet — run `agsearch --reindex`")
    body = "\033[33mno sessions match\033[0m \033[2m· " + " · ".join(hints) + "\033[0m"
    return SEP.join([NO_SID, "", body, "0"])


def _bm25_tf(tf, dl, avgdl):
    """BM25 saturated term frequency with length normalization: a term mentioned twice counts
    for much less than twice once, and a hit in a huge transcript counts for less than the same
    hit in a short, on-point one."""
    if not tf:
        return 0.0
    return tf * (BM25_K1 + 1) / (tf + BM25_K1 * (1 - BM25_B + BM25_B * dl / (avgdl or 1)))


def _age_days(date_str, now=None):
    try:
        t = time.mktime(time.strptime(date_str[:10], "%Y-%m-%d"))
    except (ValueError, OverflowError, TypeError):
        return 3650.0                                # undated → treat as ancient, never boosted
    return max(0.0, ((now if now is not None else time.time()) - t) / 86400.0)


def rel_age(date_str, now=None):
    """Compact age for a list row: today / 3d / 2w / 5mo / 2y.

    You scan a session list asking "was this the one from last week?", and an ISO date makes
    you do that subtraction yourself for every row. The exact date is one keystroke away in
    the preview card, which is where you look once you care about a specific session.
    """
    d = _age_days(date_str, now)
    if d >= 3650:
        return "?"
    if d < 1:
        return "today"
    if d < 7:
        return f"{int(d)}d"
    if d < 56:
        return f"{int(d // 7)}w"
    if d < 365:
        return f"{int(d // 30)}mo"
    return f"{int(d // 365)}y"


_RESUME_SID_RE = re.compile(r"(?:--resume|resume)\s+([0-9a-fA-F][0-9a-fA-F-]{7,})")


def _usage_counts(path=None):
    """How often each session was resumed, read back off the last-resume.log breadcrumb.
    That log is the only record of which sessions you actually return to — the sessions you
    keep reopening are the ones you most likely mean next time."""
    counts = {}
    try:
        with open(path or os.path.join(CACHE_DIR, "last-resume.log"), errors="replace") as fh:
            recent = fh.readlines()[-2000:]
    except OSError:
        return counts
    for line in recent:
        m = _RESUME_SID_RE.search(line)
        if m:
            counts[m.group(1)] = counts.get(m.group(1), 0) + 1
    return counts


def _boost(f, usage, now):
    """Multiplier for how likely this session is the one you want, independent of the query:
    recent sessions and ones you resume often. Bounded, so it re-orders near-ties without ever
    floating an irrelevant session above a real match."""
    recency = 0.5 ** (_age_days(f[C_DATE], now) / RECENCY_HALFLIFE_DAYS)
    used = usage.get(f[C_SID], 0)
    return 1.0 + RECENCY_W * recency + USAGE_W * min(1.0, math.log1p(used) / math.log(6))


def query_keys(qterms):
    """Ranking/preview keys: stem when it is long enough, else the raw term."""
    return [stem if len(stem) >= 3 else term for term, stem in qterms]


def rank_sessions(rows, qterms, usage=None, now=None):
    """Rank sessions for a query. Returns [(score, matched, row)] best-first.

    BM25 over three weighted fields — title+project, first prompt, full conversation — with
    length normalization, so a sprawling session no longer outranks a short exact match, and
    what a session was *opened to do* outweighs a passing mention buried in it. The result is
    then nudged by recency and how often you've resumed that session. A term that exists almost
    nowhere as text (a typo like 'alibrry') falls back to subsequence matching.
    """
    usage = usage or {}
    n = len(rows) or 1
    keys = query_keys(qterms)

    # Pass 1: per-field term frequencies, plus document frequency per term for idf.
    data = []
    df = dict.fromkeys(keys, 0)
    for f in rows:
        title_hay = (f[C_TITLE] + " " + short_proj(f[C_CWD])).lower()
        first_hay = f[C_FIRST].lower()
        body_hay = f[C_BLOB].lower()
        rec = []
        for key in keys:
            tf = body_hay.count(key)
            tf_first = first_hay.count(key)
            it = key in title_hay
            if tf or tf_first or it:
                df[key] += 1
            rec.append((tf, tf_first, it))
        data.append((f, title_hay, first_hay, body_hay, rec))

    avg_body = sum(len(d[3]) for d in data) / len(data) if data else 1
    avg_first = sum(len(d[2]) for d in data) / len(data) if data else 1
    # Standard BM25 idf, shifted to stay positive even for terms in most documents.
    idf = {k: math.log(1 + (n - df[k] + 0.5) / (df[k] + 0.5)) for k in df}
    typo = {k for k in df if df[k] <= 2}            # word barely exists → probably a typo, fuzzy it

    scored = []
    for f, title_hay, first_hay, body_hay, rec in data:
        score = 0.0
        matched = 0
        for (term, _stem_unused), key, (tf, tf_first, it) in zip(qterms, keys, rec):
            if tf or tf_first or it:
                matched += 1
                score += idf[key] * (W_TITLE * it
                                     + W_FIRST * _bm25_tf(tf_first, len(first_hay), avg_first)
                                     + W_BODY * _bm25_tf(tf, len(body_hay), avg_body))
            elif key in typo:
                if _fuzzy_span(title_hay, term) is not None:
                    matched += 1
                    score += 1.0
                else:
                    sp = _fuzzy_span(body_hay, term)
                    if sp is not None and sp <= len(term) * 3:
                        matched += 1
                        score += 0.3
        if matched:
            scored.append((score * _boost(f, usage, now), matched, f))
    # Categorise first: your own sessions always outrank plugin/SDK-spawned runs. Then
    # coverage (matched all your words), then relevance. Automation is demoted, never hidden.
    scored.sort(key=lambda x: (x[2][C_KIND] == "auto", -x[1], -x[0]))
    return scored


def _smart_rows(rows, qterms, live=frozenset(), usage=None, gone=frozenset(), sort="smart"):
    """Render the ranked sessions as fzf rows. Badge = matched/total query terms.

    `sort="recent"` keeps the same match set — every session that actually matched — and only
    reorders it newest-first, for when you remember *when* rather than *what*.
    """
    total = len(qterms)
    scored = rank_sessions(rows, qterms, usage)
    if sort == "recent":
        scored = sorted(scored, key=lambda x: x[2][C_DATE], reverse=True)
        scored = sorted(scored, key=lambda x: x[2][C_KIND] == "auto")   # stable: auto stays last
    return [_row(f[C_SID], f[C_CWD], f[C_DATE], f[C_SOURCE], f[C_KIND], f[C_TITLE],
                 f"\033[33m{m}/{total}\033[0m", f[C_SID] in live, f[C_CWD] in gone)
            for _score, m, f in scored[:200]]


# ------------------------------------------------------------------ live TUI filters
#
# The toggles below are what a session picker needs and `claude --resume` / `codex resume`
# don't have: narrowing without retyping. They live in a small JSON file because fzf's
# reload/preview commands are separate processes — there is no other channel between a
# keystroke binding and the next `_filter` run. State is rewritten at every TUI launch, so a
# filter can never silently persist into tomorrow's search.

DEFAULT_TUI_STATE = {"here": 0, "auto": 1, "source": "all", "sort": "smart", "root": ""}
SOURCE_CYCLE = ["all", "cc", "codex"]
SORT_CYCLE = ["smart", "recent"]


def read_tui_state(path=None):
    st = dict(DEFAULT_TUI_STATE)
    try:
        with open(path or TUI_STATE_PATH) as fh:
            got = json.load(fh)
        if isinstance(got, dict):
            st.update({k: v for k, v in got.items() if k in DEFAULT_TUI_STATE})
    except (OSError, json.JSONDecodeError, ValueError):
        pass
    return st


def write_tui_state(st, path=None):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(path or TUI_STATE_PATH, "w") as fh:
            json.dump(st, fh)
    except OSError:
        pass


def _cycle(options, cur):
    """Next option after `cur`, wrapping; anything unrecognised restarts at the first."""
    return options[(options.index(cur) + 1) % len(options) if cur in options else 0]


def toggle_tui_state(name, st):
    """Advance one toggle. Booleans flip; `source` and `sort` cycle through their options."""
    st = dict(st)
    if name in ("here", "auto"):
        st[name] = 0 if st.get(name) else 1
    elif name == "source":
        st["source"] = _cycle(SOURCE_CYCLE, st.get("source"))
    elif name == "sort":
        st["sort"] = _cycle(SORT_CYCLE, st.get("sort"))
    return st


def apply_tui_state(rows, st):
    """Drop the session rows the current toggles exclude (scope, agent, automation)."""
    root = st.get("root") or ""
    if st.get("here") and root:
        rows = [f for f in rows
                if f[C_CWD] == root or f[C_CWD].startswith(root.rstrip(os.sep) + os.sep)]
    src = st.get("source", "all")
    if src in ("cc", "codex"):
        rows = [f for f in rows if f[C_SOURCE] == src]
    if not st.get("auto", 1):
        rows = [f for f in rows if f[C_KIND] != "auto"]
    return rows


# On/off labels for the header: the *current* value, not the action, so the header reads as
# status. The key that changes it is printed beside it.
def _state_bits(st):
    scope = "this project" if st.get("here") else "all projects"
    src = {"cc": "claude only", "codex": "codex only"}.get(st.get("source"), "claude+codex")
    auto = "with automation" if st.get("auto", 1) else "yours only"
    order = "best match" if st.get("sort", "smart") == "smart" else "newest first"
    return scope, src, auto, order


NOTICES = {"copied": "\033[32m✓ resume command copied to clipboard\033[0m"}


def render_header(st=None, notice=""):
    """Two-line fzf header: what the keys do, then what the filters currently are.

    `notice` swaps the key line for a one-shot confirmation — an action like "copied" leaves
    no visible trace otherwise, and a picker that silently does nothing feels broken.
    """
    st = read_tui_state() if st is None else st
    scope, src, auto, order = _state_bits(st)
    dim, off, bold = "\033[2m", "\033[0m", "\033[1m"
    keys = (f"{bold}enter{off} resume  {bold}ctrl-t{off} resume in new tab  "
            f"{bold}ctrl-y{off} copy cmd  {bold}ctrl-o{off} read transcript  {bold}f1{off} keys")
    filt = (f"{dim}ctrl-s{off} {scope}  {dim}·{off}  {dim}ctrl-g{off} {src}  "
            f"{dim}·{off}  {dim}ctrl-x{off} {auto}  {dim}·{off}  {dim}ctrl-r{off} {order}")
    return (NOTICES.get(notice, keys)) + "\n" + filt


KEY_HELP = [
    ("enter", "resume this session here (this terminal becomes the session)"),
    ("ctrl-t", "resume in a NEW TAB of this terminal, leaving your shell alone"),
    ("ctrl-y", "copy the `cd … && claude --resume …` command to the clipboard"),
    ("ctrl-o", "read the full transcript in a pager — no resume, no token cost"),
    ("ctrl-s", "scope: all projects ⇄ only the directory you launched from"),
    ("ctrl-g", "agent: claude+codex → claude only → codex only"),
    ("ctrl-x", "automation: show or hide plugin/SDK-spawned runs"),
    ("ctrl-r", "order: best match ⇄ newest first"),
    ("ctrl-/", "show or hide this preview pane"),
    ("ctrl-\\", "move the preview: right → bottom → hidden"),
    ("ctrl-u / ctrl-d", "scroll the preview half a page"),
    ("esc", "quit without resuming anything"),
]


def render_help():
    print("\033[1magsearch keys\033[0m\n")
    for key, what in KEY_HELP:
        print(f"  \033[33m{key:<16}\033[0m {what}")
    print("\n\033[2mSearch runs over every message of every session, not just titles.\n"
          "Stopwords are dropped and words are stemmed, so 'how migration' finds 'migrate'.\n"
          "Press any arrow key to return to the session preview.\033[0m")


def parse_query(query):
    """Query string → [(word, stem)]: stopwords dropped, words conservatively stemmed."""
    words = re.findall(r"[a-z0-9]+", query.lower())
    qwords = [w for w in words if w not in _STOP] or words   # keep stopwords if that's all
    return [(w, _stem(w)) for w in qwords]


def cmd_filter(argv):
    """fzf reload target: print CLEAN session rows ranked for the live query.

    Search happens here (fzf runs --disabled), so the list shows only `date · project · N/T ·
    title` while full conversation text is searched. Smart ranking: stopwords dropped, words
    stemmed (migration≈migrate), matched per-concept (exact→stem→typo), scored by weighted
    BM25 over title / first prompt / transcript, then nudged by recency and resume count.
    """
    qterms = parse_query(" ".join(argv[1:]) if argv else "")
    st = read_tui_state()
    try:
        raw = open(SESSIONS_PATH, errors="replace").read().splitlines()
    except OSError:
        sys.stdout.write(_empty_row(st, bool(qterms)))
        return
    rows = [line.split(SEP) for line in raw if line.count(SEP) >= SESSION_COLS - 1]
    rows = apply_tui_state(rows, st)

    live = _active_sids([f[C_SID] for f in rows])
    gone = _missing_dirs([f[C_CWD] for f in rows])
    if not qterms:                                  # initial list: yours first, then automation
        rows = sorted(rows, key=lambda f: f[C_KIND] == "auto")
        out = [_row(f[C_SID], f[C_CWD], f[C_DATE], f[C_SOURCE], f[C_KIND], f[C_TITLE], "   ",
                    f[C_SID] in live, f[C_CWD] in gone) for f in rows]
    else:
        out = _smart_rows(rows, qterms, live, _usage_counts(), gone, st.get("sort", "smart"))
    sys.stdout.write("\n".join(out) if out else _empty_row(st, bool(qterms)))


def fzf_args(self, thi, fz, query, here_root=""):
    """Build the fzf argv. Split out from run_fzf so the binding table is testable.

    Every toggle key is `execute-silent(_toggle …) + reload(_filter …) + transform-header(…)`:
    the state file changes, the list is rebuilt from it, and the header re-renders to say what
    just happened. Without that third action the filter would be invisible.
    """
    me = shlex.quote(self)
    filter_cmd = "python3 {} _filter {} {{q}}".format(me, fz)
    preview = "python3 {} _preview {{1}} {} {{q}}".format(me, thi)
    header_cmd = "python3 {} _header".format(me)
    help_cmd = "python3 {} _help".format(me)

    def toggle(name):
        return ("execute-silent(python3 {} _toggle {})+reload({})+transform-header({})"
                .format(me, name, filter_cmd, header_cmd))

    args = [
        "fzf", "--ansi", "--delimiter", SEP, "--with-nth", "3", "--disabled",
        "--print-query",                 # so the clipboard gets what you actually typed
        "--header-first", "--info", "inline-right", "--pointer", "▌", "--marker", "▌",
        "--prompt", "search all sessions ▸ ",
        "--bind", "start:reload:" + filter_cmd,
        "--bind", "change:reload:" + filter_cmd,
        "--preview", preview,
        "--preview-window", "right,58%,wrap",
        "--header", render_header(),
        # Filters — the thing `claude --resume` makes you restart the process to change.
        "--bind", "ctrl-s:" + toggle("here"),
        "--bind", "ctrl-g:" + toggle("source"),
        "--bind", "ctrl-x:" + toggle("auto"),
        "--bind", "ctrl-r:" + toggle("sort"),
        # Ways out of a session that aren't "resume and hope".
        "--bind", "ctrl-t:execute-silent(python3 {} _tab {{1}} {{2}} {{q}})+abort".format(me),
        "--bind", "ctrl-y:execute-silent(python3 {} _copy {{1}} {{2}})"
                  "+transform-header(python3 {} _header copied)".format(me, me),
        "--bind", "ctrl-o:execute(python3 {} _transcript {{1}} {} {{q}} | "
                  "${{PAGER:-less}} -R)".format(me, thi),
        # Reading affordances.
        "--bind", "f1:preview(" + help_cmd + ")",
        "--bind", "ctrl-/:toggle-preview",
        "--bind", "ctrl-\\:change-preview-window(down,60%,wrap|hidden|right,58%,wrap)",
        "--bind", "ctrl-u:preview-half-page-up",
        "--bind", "ctrl-d:preview-half-page-down",
    ]
    if query:
        args += ["--query", query]
    return args


def run_fzf(lines, query, thinking=False, no_resume=False, fuzzy=False, here=False):
    if not shutil.which("fzf"):
        print("fzf not installed. Falling back to non-interactive output.\n"
              "Install with: brew install fzf\n", file=sys.stderr)
        return print_matches(lines, query)

    self = os.path.abspath(__file__)
    build_sessions(lines)                # refresh the per-session cache _filter reads
    # Start every TUI from a known state, seeded by the flags you launched with, so a toggle
    # you flipped last week can never quietly hide half your sessions today.
    st = dict(DEFAULT_TUI_STATE)
    st["here"] = 1 if here else 0
    st["root"] = os.getcwd()
    write_tui_state(st)

    args = fzf_args(self, "1" if thinking else "0", "1" if fuzzy else "0", query)
    proc = subprocess.run(args, input="", text=True, capture_output=True)
    out = proc.stdout.split("\n")
    typed = out[0] if out else query     # --print-query puts the final query on line 1
    sel = next((l for l in out[1:] if l.strip()), "")
    if not sel:
        return 0
    f = (sel.split(SEP) + [""] * 4)[:4]
    sid, cwd, active = f[0], f[1], f[3] == "1"
    if not sid or sid == NO_SID:         # the "no sessions match" placeholder row
        return 0
    if no_resume:
        print(resume_command(sid, cwd, _source_of(sid)))
        return 0
    resume(sid, cwd, typed, active=active)
    return 0


# ------------------------------------------------------------------ main

def _internal(argv):
    """Subcommands fzf calls back into. Return an exit code, or None if this isn't one."""
    cmd = argv[0] if argv else ""
    if cmd == "_preview":
        render_preview(argv[1] if len(argv) > 1 else "",
                       argv[2] if len(argv) > 2 else "0", " ".join(argv[3:]))
        return 0
    if cmd == "_filter":
        cmd_filter(argv[1:])
        return 0
    if cmd == "_transcript":
        render_transcript(argv[1] if len(argv) > 1 else "",
                          argv[2] if len(argv) > 2 else "0", " ".join(argv[3:]))
        return 0
    if cmd == "_header":
        print(render_header(notice=" ".join(argv[1:])))
        return 0
    if cmd == "_help":
        render_help()
        return 0
    if cmd == "_toggle":
        write_tui_state(toggle_tui_state(argv[1] if len(argv) > 1 else "", read_tui_state()))
        return 0
    if cmd == "_copy":
        sid = argv[1] if len(argv) > 1 else ""
        cwd = argv[2] if len(argv) > 2 else ""
        if sid and sid != NO_SID:
            copy_to_clipboard(resume_command(sid, cwd, _source_of(sid)))
        return 0
    if cmd == "_tab":
        sid = argv[1] if len(argv) > 1 else ""
        cwd = argv[2] if len(argv) > 2 else ""
        query = " ".join(argv[3:])
        if not sid or sid == NO_SID:
            return 0
        if query:
            copy_to_clipboard(query)
        if not open_in_tab(resume_command(sid, cwd, _source_of(sid))):
            print("no scriptable terminal found for a new tab — set AGSEARCH_TERMINAL_CMD",
                  file=sys.stderr)
            return 1
        return 0
    return None


HELP = """agsearch — one search across every Claude Code and Codex CLI session, then resume it.

usage:
  agsearch                      interactive search over all sessions
  agsearch "stripe tax id"      open the search pre-filtered to a query
  agsearch -n "stripe tax id"   non-interactive: print ranked matches, no fzf

options:
  --here                start scoped to the current directory's project (ctrl-s toggles)
  -p, --project NAME    only sessions whose path contains NAME
  --thinking            also search assistant thinking blocks
  --fuzzy               fuzzy matching instead of exact substring
  --new-tab             open agsearch in a NEW TAB of this terminal, then exit
  --no-resume           print the resume command instead of running it
  --reindex             force a full cache rebuild
  -n, --no-fzf          plain ranked output
  -h, --help            this text

in the search:
{keys}

environment:
  AGSEARCH_TERMINAL      force the terminal used by --new-tab / ctrl-t
                         (tmux | kitty | wezterm | iterm | terminal)
  AGSEARCH_TERMINAL_CMD  full override; "{{cmd}}" is replaced by the command to run

Everything runs locally: sessions are read from ~/.claude/projects and ~/.codex/sessions,
cached under ~/.cache/agsearch, and never leave the machine."""


def print_help():
    keys = "\n".join(f"  {k:<16} {what}" for k, what in KEY_HELP)
    print(HELP.format(keys=keys))


def main(argv):
    code = _internal(argv)
    if code is not None:
        return code

    no_fzf = no_resume = here = thinking = reindex = fuzzy = new_tab = False
    project = None
    query_parts = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-n", "--no-fzf"):
            no_fzf = True
        elif a == "--no-resume":
            no_resume = True
        elif a == "--here":
            here = True
        elif a == "--thinking":
            thinking = True
        elif a == "--fuzzy":
            fuzzy = True
        elif a == "--reindex":
            reindex = True
        elif a == "--new-tab":
            new_tab = True
        elif a in ("-p", "--project"):
            i += 1
            project = argv[i] if i < len(argv) else None
        elif a in ("-h", "--help"):
            print_help()
            return 0
        else:
            query_parts.append(a)
        i += 1

    query = " ".join(query_parts)
    if new_tab:
        # Relaunch ourselves in a tab of the current terminal. This is what a global hotkey
        # should bind to: the tab it opens becomes the resumed session, instead of leaving a
        # stray window behind every time you search.
        rest = [a for a in argv if a != "--new-tab"]
        inner = "exec " + " ".join(shlex.quote(x) for x in [os.path.abspath(__file__)] + rest)
        if open_in_tab(inner):
            return 0
        print("no scriptable terminal found — set AGSEARCH_TERMINAL_CMD, or drop --new-tab",
              file=sys.stderr)
        return 1

    lines = build_index(include_thinking=thinking, force=reindex)
    # --here is a *starting* scope in the TUI (ctrl-s widens it), so only -n applies it here.
    lines = apply_scope(lines, here=here and no_fzf, project=project)
    if not lines:
        print("No indexed sessions found.", file=sys.stderr)
        return 1

    if no_fzf:
        return print_matches(lines, query)
    return run_fzf(lines, query, thinking=thinking, no_resume=no_resume, fuzzy=fuzzy, here=here)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except SystemExit:
        raise
    except Exception:                       # never let the popup vanish without a reason
        import traceback
        _die("agsearch crashed:\n\n" + traceback.format_exc())
